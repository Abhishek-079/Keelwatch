# Copy this file to .env.local and fill in what you need. Never commit .env.local.
# Everything is optional except where noted. The site works with no settings at all (live pages only).

# --- Database (Neon Postgres). Needed for history, stress view and alerts. ---
DATABASE_URL=

# --- Scheduled job protection. Required for /api/cron/snapshot. Any random text, 16+ characters. ---
CRON_SECRET=

# --- Stellar RPC. Defaults are public endpoints; use your own provider if these get rate limited. ---
MAINNET_RPC_URL=https://soroban-rpc.mainnet.stellar.gateway.fm
TESTNET_RPC_URL=https://soroban-testnet.stellar.org

# --- Alerts (server-side secrets) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
# Which networks send alerts (comma separated). Testnet is off by default because it uses mock oracles.
ALERT_NETWORKS=mainnet
# Your public site address, used for links inside alert messages (no trailing slash).
PUBLIC_SITE_URL=

# --- Public join links shown on /alerts (safe to show) ---
PUBLIC_TELEGRAM_URL=
PUBLIC_DISCORD_URL=
NEXT_PUBLIC_REPO_URL=

# --- Optional ---
COINGECKO_API_KEY=
# Extra pools to watch, comma separated contract ids (C...)
EXTRA_POOLS_MAINNET=
EXTRA_POOLS_TESTNET=
SNAPSHOT_NETWORKS=mainnet,testnet
HISTORY_DAYS=90

# --- Thresholds (defaults shown) ---
UTIL_WARN=0.9
UTIL_CRIT=0.98
ORACLE_GAP_WARN_PCT=2
ORACLE_GAP_CRIT_PCT=10
ORACLE_STALE_SEC=1800
BAD_DEBT_USD_WARN=1
STRESS_LIAB_USD_WARN=10000
Q4W_WARN_PCT=25
ALERT_COOLDOWN_MIN=60
ALERT_REMIND_HOURS=6
ALERT_MAX_PER_RUN=10
MAX_POOLS=12
CACHE_SECONDS=60
RATE_LIMIT_PER_MIN=60
MAX_TRACKED_ACCOUNTS_PER_POOL=2000
